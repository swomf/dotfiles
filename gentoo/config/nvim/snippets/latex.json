{
  "aligned block": {
    "prefix": "maths",
    "description": "make a begin{aligned} block",
    "body": [
      "$$",
      "\\begin{aligned}",
      "$1",
      "\\end{aligned}",
      "$$"
    ]
  },
  "problem": {
    "prefix": "prob",
    "description": "make a problem block",
    "body": [
      "\\begin{problem}{$1}",
      "$2",
      "\\end{problem}"
    ]
  },
  "solution": {
    "prefix": "sol",
    "description": "make a solution block",
    "body": [
      "\\begin{solution}",
      "$1",
      "\\end{solution}"
    ]
  },
  "response": {
    "prefix": "resp",
    "description": "make a left-line block",
    "body": [
      "\\begin{response}",
      "$1",
      "\\end{response}"
    ]
  }
}
